# ==========================================
# Laravel runtime for Vercel container service
#
# No frontend stage: this app has no @vite directive anywhere and its
# styles are inline in the Blade layout, so there is nothing to build.
# ==========================================
FROM php:8.3-cli

WORKDIR /app

# pdo_mysql and pdo_pgsql are both installed so the same image works
# whichever engine the Aiven service uses. gd is for dompdf (payslip PDFs).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libzip-dev \
    libonig-dev \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        pdo_pgsql \
        mbstring \
        zip \
        gd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer


# ==========================================
# Copy the application in small layers
# ==========================================

COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY resources ./resources
COPY routes ./routes
COPY storage ./storage
COPY public ./public

COPY artisan ./
COPY composer.json ./
COPY composer.lock ./


# ==========================================
# PHP production dependencies
# ==========================================

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader


# ==========================================
# Laravel writable directories
# ==========================================

RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    storage/app/public \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache


# ==========================================
# Aiven requires TLS. The CA certificate is supplied as an env var, but
# PDO's SSL option needs a file path, so write it out before starting.
# ==========================================

CMD ["sh", "-c", "\
    if [ -n \"$AIVEN_CA_CERT\" ]; then \
        printf '%s' \"$AIVEN_CA_CERT\" > /app/storage/aiven-ca.pem; \
        export MYSQL_ATTR_SSL_CA=/app/storage/aiven-ca.pem; \
    fi; \
    php artisan serve --host=0.0.0.0 --port=${PORT:-80}"]
