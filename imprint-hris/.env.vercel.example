# Environment variables for Vercel → Project → Settings → Environment Variables.
#
# The blank values below are SECRETS. Paste them in the Vercel dashboard only —
# never fill them in here, this file is committed to a public repository.

APP_NAME="Imprint HRIS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # generate with: php artisan key:generate --show
APP_URL=https://<your-project>.vercel.app

# --- Aiven MySQL ----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql-24eb9330-imprintcustoms-73f1.d.aivencloud.com
DB_PORT=23655
DB_DATABASE=hris
DB_USERNAME=avnadmin
DB_PASSWORD=                  # SECRET — Aiven console → Connection information

# Aiven enforces SSL (ssl-mode=REQUIRED). Click "Show" next to CA certificate in
# the Aiven console and paste the whole thing, BEGIN/END lines included.
# Dockerfile.vercel writes it to a file at startup because PDO's SSL option
# takes a path, not text.
AIVEN_CA_CERT=                # SECRET-ish — paste in Vercel

# --- Vercel Blob (file uploads) -------------------------------------------
# Added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# --- Drivers --------------------------------------------------------------
# Containers are replaced on every deploy, so nothing may live on local disk.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
