# Environment variables to set in Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values. Copy each key across and paste the secrets yourself.

APP_NAME="Imprint HRIS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # generate with: php artisan key:generate --show
APP_URL=https://<your-project>.vercel.app

# --- Aiven database -------------------------------------------------------
# Copy these from the Aiven console → your service → "Connection information".
DB_CONNECTION=mysql           # use "pgsql" if you created a PostgreSQL service
DB_HOST=
DB_PORT=                      # Aiven does not use 3306/5432 — check the console
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# Aiven requires TLS. Download "CA Certificate" from the Aiven console and paste
# its full contents (including the BEGIN/END lines) here. The container writes it
# to a file at startup and points PDO at that path — PDO needs a path, not text.
AIVEN_CA_CERT=
# For PostgreSQL use this instead:
# DB_SSLMODE=require

# --- Vercel Blob (file uploads) -------------------------------------------
# Create a Blob store in the Vercel dashboard; the token is added automatically
# when you connect the store to the project.
BLOB_READ_WRITE_TOKEN=

# --- Drivers --------------------------------------------------------------
# All database-backed: serverless has no persistent local filesystem.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
